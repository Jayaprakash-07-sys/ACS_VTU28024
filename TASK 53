import java.util.*;

class Solution {

    public List<List<Integer>> kSmallestPairs(int[] nums1, int[] nums2, int k) {

        List<List<Integer>> result = new ArrayList<>();

        PriorityQueue<int[]> pq = new PriorityQueue<>(
            (a, b) -> Integer.compare(a[0], b[0])
        );

        int n = Math.min(k, nums1.length);

        // Pair first k elements of nums1 with nums2[0]
        for (int i = 0; i < n; i++) {
            pq.offer(new int[] {
                nums1[i] + nums2[0],
                i,
                0
            });
        }

        while (!pq.isEmpty() && result.size() < k) {

            int[] current = pq.poll();

            int i = current[1];
            int j = current[2];

            List<Integer> pair = new ArrayList<>();
            pair.add(nums1[i]);
            pair.add(nums2[j]);

            result.add(pair);

            // Add next pair from the same nums1 element
            if (j + 1 < nums2.length) {
                pq.offer(new int[] {
                    nums1[i] + nums2[j + 1],
                    i,
                    j + 1
                });
            }
        }

        return result;
    }
}
