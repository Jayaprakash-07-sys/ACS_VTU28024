import java.util.*;
class Main {
    static int[] dr = {-1, 1, 0, 0};
    static int[] dc = {0, 0, -1, 1};

    static class Cell {
        int r, c;

        Cell(int r, int c) {
            this.r = r;
            this.c = c;
        }
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int r = sc.nextInt();
        int c = sc.nextInt();

        int[][] grid = new int[r][c];
        Queue<Cell> q = new LinkedList<>();

        int trees = 0;

        for (int i = 0; i < r; i++) {
            for (int j = 0; j < c; j++) {
                grid[i][j] = sc.nextInt();

                if (grid[i][j] == 2)
                    q.add(new Cell(i, j));

                if (grid[i][j] == 1)
                    trees++;
            }
        }

        int minutes = 0;

        while (!q.isEmpty()) {
            int size = q.size();
            boolean spread = false;

            for (int i = 0; i < size; i++) {
                Cell cur = q.poll();

                for (int d = 0; d < 4; d++) {
                    int nr = cur.r + dr[d];
                    int nc = cur.c + dc[d];

                    if (nr >= 0 && nr < r &&
                        nc >= 0 && nc < c &&
                        grid[nr][nc] == 1) {

                        grid[nr][nc] = 2;
                        trees--;
                        q.add(new Cell(nr, nc));
                        spread = true;
                    }
                }
            }

            if (spread)
                minutes++;
        }

        System.out.println("Minutes = " + (trees == 0 ? minutes : -1));
    }
}
