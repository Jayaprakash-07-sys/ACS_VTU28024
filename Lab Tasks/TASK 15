import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int W = sc.nextInt();

        int[] weight = new int[n + 1];
        int[] value = new int[n + 1];

        for (int i = 1; i <= n; i++) {
            weight[i] = sc.nextInt();
            value[i] = sc.nextInt();
        }

        int[][] dp = new int[n + 1][W + 1];

        for (int i = 1; i <= n; i++) {
            for (int w = 0; w <= W; w++) {

                dp[i][w] = dp[i - 1][w];

                if (weight[i] <= w) {
                    dp[i][w] = Math.max(
                        dp[i][w],
                        value[i] + dp[i - 1][w - weight[i]]
                    );
                }
            }
        }

        ArrayList<Integer> selected = new ArrayList<>();

        int w = W;

        for (int i = n; i >= 1; i--) {
            if (dp[i][w] != dp[i - 1][w]) {
                selected.add(i);
                w -= weight[i];
            }
        }

        Collections.sort(selected);

        System.out.println("MaximumValue = " + dp[n][W]);
        System.out.println("SelectedItems:");

        for (int x : selected)
            System.out.print(x + " ");
    }
}
